    binding.writeFormatContextFrame(this._handle, packet._handle)
  }

  writeTrailer() {
    binding.writeFormatContextTrailer(this._handle)
  }

  dump(printIdx = 0, printUrl = '') {
    binding.dumpFormatContext(this._handle, true, printIdx, printUrl)
  }

