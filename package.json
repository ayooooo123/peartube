{
  "name": "peartube",
  "version": "0.4.43",
  "description": "Decentralized CDN and debrid provider on the Holepunch stack",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "imports": {
    "node:crypto": {
      "bare": "peartube-crypto",
      "default": "node:crypto"
    },
    "node:child_process": {
      "bare": "bare-subprocess",
      "default": "node:child_process"
    },
    "node:events": {
      "bare": "bare-events",
      "default": "node:events"
    },
    "node:fs": {
      "bare": "bare-fs",
      "default": "node:fs"
    },
    "node:http": {
      "bare": "bare-http1",
      "default": "node:http"
    },
    "node:https": {
      "bare": "bare-https",
      "default": "node:https"
    },
    "node:net": {
      "bare": "bare-net",
      "default": "node:net"
    },
    "node:process": {
      "bare": "bare-process",
      "default": "node:process"
    },
    "node:os": {
      "bare": "bare-os",
      "default": "node:os"
    },
    "node:path": {
      "bare": "bare-path",
      "default": "node:path"
    },
    "buffer": {
      "bare": "bare-buffer",
      "default": "node:buffer"
    },
    "crypto": {
      "bare": "peartube-crypto",
      "default": "node:crypto"
    },
    "dgram": {
      "bare": "bare-dgram",
      "default": "node:dgram"
    },
    "events": {
      "bare": "bare-events",
      "default": "node:events"
    },
    "net": {
      "bare": "bare-net",
      "default": "node:net"
    },
    "os": {
      "bare": "bare-os",
      "default": "node:os"
    }
  },
  "bin": {
    "peartube-relay": "bin/relay.js",
    "peartube-private-relay": "bin/private-relay.js"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');if(fs.existsSync('node_modules')){for(const[k,v]of[['events','bare-events'],['dgram','bare-dgram'],['os','bare-os'],['net','bare-net'],['crypto','peartube-crypto'],['buffer','bare-buffer']])if(fs.existsSync(p.join('node_modules',v))){const t=p.join('node_modules',k);fs.rmSync(t,{recursive:true,force:true});fs.symlinkSync(v,t)}try{const b=require('bare-runtime')();fs.chmodSync(b,0o755);fs.mkdirSync('node_modules/.bin',{recursive:true});fs.rmSync('node_modules/.bin/bare',{force:true});fs.symlinkSync(p.relative('node_modules/.bin',b),'node_modules/.bin/bare')}catch{}}\"",
    "start": "./node_modules/.bin/bare bin/relay.js",
    "test": "node --test --test-force-exit test/*.test.js",
    "test:desktop": "node --test --test-force-exit test/desktop.e2e.js",
    "test:cast": "node --test test/cast.e2e.js",
    "test:web": "node --test test/web-player.e2e.js",
    "app": "sh desktop/bundle.sh --open",
    "app:rust": "sh desktop/bundle.sh --engine rust --open",
    "engine": "python3 sync-native.py engine"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hyperswarm/secret-stream": "^6.9.2",
    "autobee": "github:ayooooo123/autobee#dd5080037a435e275ef751e2e44e6d07f91092e5",
    "b4a": "^1.9.0",
    "bare": "1.36.0",
    "bare-buffer": "^3.7.1",
    "bare-dgram": "1.1.1",
    "bare-events": "^2.9.1",
    "bare-fs": "^4.7.2",
    "bare-http1": "^4.6.2",
    "bare-https": "^3.1.0",
    "bare-net": "2.3.3",
    "bare-os": "3.9.1",
    "bare-path": "^3.0.1",
    "bare-process": "4.5.1",
    "bare-subprocess": "^6.2.2",
    "bare-ubit": "github:ayooooo123/bare-ubit#fb19d67b4ec6746721c7632f6d40533323d66d02",
    "bonjour-service": "^1.4.4",
    "compact-encoding": "^3.6.0",
    "corestore": "github:ayooooo123/corestore#2edcbbefe23bd55bc711488b94a9f41e48632b5f",
    "hyperblobs": "^2.13.0",
    "hypercore": "github:ayooooo123/hypercore#ca652cae7aca0430a1e9d86c1acd4f783243a265",
    "hypercore-byte-stream": "2.0.4",
    "hypercore-crypto": "^3.7.0",
    "hypercore-storage": "^3.4.0",
    "hyperdht": "^6.36.0",
    "hyperswarm": "^4.17.2",
    "peartube-crypto": "file:worklet/crypto",
    "protomux": "^3.13.0",
    "protomux-wakeup": "^2.9.0",
    "sodium-native": "5.1.0",
    "streamx": "^2.28.1",
    "udx-native": "^1.22.1"
  },
  "devDependencies": {
    "bare-link": "4.1.0",
    "bare-pack": "3.0.2"
  },
  "overrides": {
    "sodium-native": "$sodium-native",
    "hypercore": "$hypercore",
    "corestore": "$corestore"
  },
  "private": true
}
