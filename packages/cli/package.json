{
  "name": "@peartube/cli",
  "version": "0.1.185",
  "private": true,
  "type": "module",
  "bin": {
    "peartube": "peartube.js",
    "peartube-relay": "bin.js",
    "peartube-peer": "bin.js",
    "peartube-relay-bare": "bare-bin.js",
    "peartube-peer-bare": "bare-bin.js"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "add:smoke": "node ./scripts/add-smoke.mjs",
    "build:standalone": "node ./scripts/build-standalone.mjs",
    "build:standalone:linux-x64": "RELAY_STANDALONE_HOST=linux-x64 node ./scripts/build-standalone.mjs",
    "build:standalone:linux-arm64": "RELAY_STANDALONE_HOST=linux-arm64 node ./scripts/build-standalone.mjs",
    "prepare:docker-artifacts": "node ./scripts/prepare-docker-artifacts.mjs"
  },
  "imports": {
    "#os": {
      "bare": "./src/shims/os.bare.js",
      "default": "./src/shims/os.node.js"
    },
    "#fs": {
      "bare": "./src/shims/fs.bare.js",
      "default": "./src/shims/fs.node.js"
    },
    "#path": {
      "bare": "./src/shims/path.bare.js",
      "default": "./src/shims/path.node.js"
    },
    "#process": {
      "bare": "./src/shims/process.bare.js",
      "default": "./src/shims/process.node.js"
    },
    "#subprocess": {
      "bare": "./src/shims/subprocess.bare.js",
      "default": "./src/shims/subprocess.node.js"
    },
    "#dns": {
      "bare": "./src/shims/dns.bare.js",
      "default": "./src/shims/dns.node.js"
    },
    "#http": {
      "bare": "./src/shims/http.bare.js",
      "default": "./src/shims/http.node.js"
    },
    "#fetch": {
      "bare": "./src/shims/fetch.bare.js",
      "default": "./src/shims/fetch.node.js"
    },
    "#https": {
      "bare": "./src/shims/https.bare.js",
      "default": "./src/shims/https.node.js"
    }
  },
  "dependencies": {
    "@peartube/backend": "file:../backend",
    "@peartube/host": "file:../host",
    "abort-controller": "^3.0.0",
    "b4a": "^1.8.0",
    "bare-dns": "^2.1.4",
    "bare-http1": "^4.5.6",
    "bare-os": "^3.9.3",
    "bare-net": "^2.3.3",
    "bare-https": "^3.0.0",
    "bare-process": "^4.4.1",
    "bare-subprocess": "^6.0.0",
    "compact-encoding": "^2.19.2",
    "graceful-goodbye": "^1.3.3",
    "hypercore-crypto": "^3.6.1",
    "hypercore-id-encoding": "^1.3.0",
    "sodium-universal": "^5.0.1"
  },
  "devDependencies": {
    "bare-build": "^0.5.3",
    "bare-runtime": "^1.28.4",
    "brittle": "^3.19.1",
    "node-pty": "^1.0.0"
  }
}
