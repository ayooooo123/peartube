const ipAddress = {
  preencode(state, m) {
    ip.preencode(state, m.host)
    port.preencode(state, m.port || 0)
  },
  encode(state, m) {
    ip.encode(state, m.host)
    port.encode(state, m.port || 0)
  },
  decode(state) {
    const family = c.uint8.decode(state)
