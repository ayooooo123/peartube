    case '@peartubeChannel/invite':
      return encoding5
    case '@peartubeChannel/watchEvent':
      return encoding6
    case '@peartubeChannel/vectorIndex':
      return encoding7
    case '@peartubeChannel/channelProfile':
      return encoding8
    case '@peartubeChannel/contentDetails':
      return encoding9
    case '@peartubeChannel/channelSource':
      return encoding10
    case '@peartubeChannel/channelArtwork':
      return encoding11
    case '@peartubeChannel/importClaim':
      return encoding12
    case '@peartubeChannel/metadata/hyperdb#0':
      return encoding13
    case '@peartubeChannel/writer/hyperdb#1':
      return encoding14
    case '@peartubeChannel/video/hyperdb#2':
      return encoding15
    case '@peartubeChannel/comment/hyperdb#3':
      return encoding16
    case '@peartubeChannel/reaction/hyperdb#4':
      return encoding17
    case '@peartubeChannel/invite/hyperdb#5':
      return encoding18
    case '@peartubeChannel/watchEvent/hyperdb#6':
      return encoding19
    case '@peartubeChannel/vectorIndex/hyperdb#7':
      return encoding20
    case '@peartubeChannel/channelProfile/hyperdb#13':
      return encoding21
    case '@peartubeChannel/contentDetails/hyperdb#14':
      return encoding22
    case '@peartubeChannel/channelSource/hyperdb#15':
      return encoding23
