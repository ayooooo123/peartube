{
  "expo": {
    "name": "PearTube",
    "slug": "peartube",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "peartube",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0e10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.peartube.app",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSLocalNetworkUsageDescription": "PearTube uses the local network to discover cast devices and peer-to-peer streams.",
        "NSBonjourServices": [
          "_googlecast._tcp",
          "_CC1AD845._googlecast._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0e0e10"
      },
      "package": "com.peartube.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.NEARBY_WIFI_DEVICES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router"
      ],
      "./plugins/withEnsureBackendBundles.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow PearTube to save videos to your device.",
          "savePhotosPermission": "Allow PearTube to save videos to your device.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "./plugins/withAndroidPiP.js",
      "./plugins/withMainActivityPiPCallback.js",
      "./plugins/withAndroidMediaSessionServices.js",
      "./plugins/withExoplayerKeepResources.js",
      "./plugins/withAndroidAbiSplits.js",
      "./plugins/withVectorIconFonts.js",
      "expo-font"
    ]
  }
}
