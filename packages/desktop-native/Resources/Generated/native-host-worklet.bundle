  ready() {
    return this.snapshot.ready()
  }

  ref() {
    this.refs++
    return this
  }

  unref() {
    if (--this.refs === 0) {
      this.closed = true
      this.snapshot.close().catch(noop)
      for (const b of this.batches) b.destroy()
