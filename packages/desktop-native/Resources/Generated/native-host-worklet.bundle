  encode(state, m) {
    c.optionalBuffer.encode(state, m.data)
    c.fixed64.encode(state, m.signature)
  },
  decode(state) {
    return {
      data: c.optionalBuffer.decode(state),
      signature: c.fixed64.decode(state)
