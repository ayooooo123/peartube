const c = require('compact-encoding')

const port = c.uint16

const address = (host, family) => {
  return {
    preencode(state, m) {
      host.preencode(state, m.host)
      port.preencode(state, m.port || 0)
    },
    encode(state, m) {
      host.encode(state, m.host)
      port.encode(state, m.port || 0)
