      return true
    }

    if (range.length > MAX_RANGE) return false

    if (!validateBatchRange(range)) {
      this.all = true
      return true
    }

    if (this.size >= MAX) {
      this.all = true
      return true
    }

    for (let i = 0; i < this.batches.length; i++) {
      const b = this.batches[i]
      if (b.length === range.length) {
        b.ranges.add(range.start / range.length)
        this.size++
        return true
