{
  "expo": {
    "name": "NitroVLC Example",
    "slug": "nitro-vlc-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0e10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nitrovlc.example"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e0e10"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nitrovlc.example"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
