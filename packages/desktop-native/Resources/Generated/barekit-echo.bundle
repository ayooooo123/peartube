{"version":0,"id":"74882e910a417755c07630e8c16cd04ee1b02a9703b3f0ee5387feafb5ae4727","main":"/packages/desktop-native/Bridge/barekit-echo-worklet.cjs","imports":{},"resolutions":{"/packages/desktop-native/Bridge/barekit-echo-worklet.cjs":{"#package":"/packages/desktop-native/package.json"},"/packages/desktop-native/package.json":{}},"addons":[],"assets":[],"files":{"/packages/desktop-native/Bridge/barekit-echo-worklet.cjs":{"offset":0,"length":105,"mode":420},"/packages/desktop-native/package.json":{"offset":105,"length":1969,"mode":420}}}
const { IPC } = BareKit

IPC.on('data', (data) => {
  IPC.write(data)
})

setInterval(() => {}, 1 << 30)
{
  "name": "@peartube/desktop-native",
  "private": true,
  "version": "0.1.115",
  "description": "Native macOS shell scaffold for PearTube",
  "scripts": {
    "ensure:barekit-echo": "node ./scripts/ensure-barekit-echo-bundle.mjs",
    "ensure:barekit-bare-fs": "node ./scripts/ensure-barekit-bare-fs-bundle.mjs",
    "ensure:barekit-corestore": "node ./scripts/ensure-barekit-corestore-bundle.mjs",
    "ensure:bare-runtime": "node ./scripts/ensure-bare-runtime-binary.mjs",
    "ensure:host-sidecar": "node ./scripts/ensure-host-sidecar-bundle.mjs",
    "ensure:host-worklet": "node ./scripts/ensure-host-worklet-bundle.mjs",
    "ensure:host-worklet-frameworks": "node ./scripts/ensure-host-sidecar-frameworks.mjs",
    "generate": "npm run ensure:barekit-echo && npm run ensure:barekit-bare-fs && npm run ensure:barekit-corestore && npm run ensure:bare-runtime && npm run ensure:host-sidecar && npm run ensure:host-worklet && npm run ensure:host-worklet-frameworks && xcodegen generate",
    "build": "npm run generate && xcodebuild -project PearTubeDesktop.xcodeproj -scheme PearTubeDesktop -configuration Debug -derivedDataPath build build",
    "test:bridge": "npm run ensure:barekit-echo && npm run ensure:barekit-bare-fs && npm run ensure:barekit-corestore && npm run ensure:bare-runtime && npm run ensure:host-sidecar && npm run ensure:host-worklet && npm run ensure:host-worklet-frameworks && node --test scripts/bare-pack-host-flags.test.mjs scripts/barekit-build-contract.test.mjs Bridge/bridge-core.test.mjs Bridge/native-rpc.test.mjs Bridge/playback-resolution.test.mjs Bridge/sidecar-addon-roots.test.mjs Bridge/native-host-sidecar.test.mjs",
    "test": "npm run generate && npm run test:bridge && xcodebuild -project PearTubeDesktop.xcodeproj -scheme PearTubeDesktop -configuration Debug -derivedDataPath build test",
    "run": "open ./build/Build/Products/Debug/PearTubeDesktop.app"
  },
  "overrides": {
    "bare-module-lexer": ">=1.5.2"
  }
}
