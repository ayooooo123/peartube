  _destroy(cb) {
    if (this._range) this._range.destroy()
    this.core.close().then(cb, cb)
  }

  _prefetch(index) {
    const blocks = []
    for (; index < this._endIndex; index++) blocks.push(this._blockMap.blocks[index].index)
