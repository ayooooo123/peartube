switch (Bare.platform) {
  case 'darwin':
  case 'ios':
    defaultURL = '0:0'
    break
  case 'linux':
    // TODO: test on real machine
    // we might need separate contexts for linux
    // video: V4L2 and audio: ALSA/PulseAudio
    defaultURL = '/dev/video0'
    break
  case 'win32':
    defaultURL = 'video=Integrated Camera'
    break
