  return IPv4Pattern.test(host)
})

const isIPv6 = (exports.isIPv6 = function isIPv6(host) {
  return IPv6Pattern.test(host)
})

exports.isIP = function isIP(host) {
  if (isIPv4(host)) return 4
  if (isIPv6(host)) return 6
  return 0
}
