    if (state.end - state.start < 4) throw new Error('Out of bounds')
    return (
      state.buffer[state.start++] * 0x1000000 +
      state.buffer[state.start++] * 0x10000 +
      state.buffer[state.start++] * 0x100 +
      state.buffer[state.start++]
