const c = require('compact-encoding')

const DHTNodes = c.array(c.ipv4Address)

const Invite = {
  preencode(state, i) {
    state.end++ // version
    state.end++ // flags
    c.fixed32.preencode(state, i.seed)
    if (i.discoveryKey) c.fixed32.preencode(state, i.discoveryKey)
    if (i.expires) c.uint32.preencode(state, Math.floor(i.expires / 1000)) // store as secs
    if (i.additionalNodes && Array.isArray(i.additionalNodes))
      DHTNodes.preencode(
        state,
        i.additionalNodes.filter((node) => !isBogon(node.host))
      )
  },
  encode(state, i) {
    c.uint.encode(state, 1) // version
    c.uint.encode(
      state,
      (i.discoveryKey ? 1 : 0) |
        (i.expires ? 2 : 0) |
        (i.sensitive ? 4 : 0) |
        (i.testInvitation ? 8 : 0) |
        (i.additionalNodes && Array.isArray(i.additionalNodes) ? 16 : 0)
    )
    c.fixed32.encode(state, i.seed)
    if (i.discoveryKey) c.fixed32.encode(state, i.discoveryKey)
    if (i.expires) c.uint32.encode(state, Math.floor(i.expires / 1000))
    if (i.additionalNodes && Array.isArray(i.additionalNodes))
      DHTNodes.encode(
        state,
        i.additionalNodes.filter((node) => !isBogon(node.host))
      )
  },
  decode(state) {
    const version = c.uint.decode(state)
    if (version !== 1) {
      throw new Error('Unknown invite version')
    }

    const flags = c.uint.decode(state)

    return {
      seed: c.fixed32.decode(state),
      discoveryKey: flags & 1 ? c.fixed32.decode(state) : null,
      expires: flags & 2 ? c.uint32.decode(state) * 1000 : 0,
      sensitive: (flags & 4) !== 0,
      testInvitation: (flags & 8) !== 0,
      additionalNodes: flags & 16 ? DHTNodes.decode(state) : null
    }
  }
}

const RequestPayload = {
  preencode(state, p) {
    c.optionalBuffer.preencode(state, p.session)
    c.optionalBuffer.preencode(state, p.data)
