    if (this.fastForwardTo !== null) return
    if (Date.now() - this.fastForwardFailedAt < MIN_FF_WAIT) return

    this._runFastForward(new FastForward(this, key, { verified: false })).catch(noop)
  }

  _updateActivity() {
    this.activeWriters.updateActivity()
    if (this._applyState) {
