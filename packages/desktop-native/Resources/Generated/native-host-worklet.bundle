    c.uint8.encode(state, family)

    if (family === 4) ipv4.encode(state, string)
    else ipv6.encode(state, string)
  },
  decode(state) {
    const family = c.uint8.decode(state)

    if (family === 4) return ipv4.decode(state)
    else return ipv6.decode(state)
  }
