  encode(state, p) {
    c.optionalBuffer.encode(state, p.session)
    c.optionalBuffer.encode(state, p.data)
  },
  decode(state) {
    return {
      session: c.optionalBuffer.decode(state),
      data: c.optionalBuffer.decode(state)
    }
  }
}

