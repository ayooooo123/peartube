{
  "expo": {
    "name": "PearTube",
    "slug": "peartube",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "peartube",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.peartube.app",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSLocalNetworkUsageDescription": "PearTube uses the local network to discover cast devices and peer-to-peer streams.",
        "NSBonjourServices": [
          "_googlecast._tcp",
          "_CC1AD845._googlecast._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0e0e10"
      },
      "package": "com.peartube.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0e0e10"
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "./plugins/withEnsureBackendBundles.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 29,
            "usesCleartextTraffic": false,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class to.holepunch.** { *; }"
          }
        }
      ],
      "./plugins/withAndroidPiP.js",
      "./plugins/withExpoVideoNotificationTap.js",
      "./plugins/withPipBackgroundAudio.js",
      "./plugins/withNextLib.js",
      "./plugins/withExoplayerKeepResources.js",
      "./plugins/withAndroidAbiSplits.js",
      "./plugins/withVectorIconFonts.js",
      "expo-font"
    ]
  }
}
