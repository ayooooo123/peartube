  'blobsCoreKey',
  'mimeType',
  'remoteUrl',
])
const CATALOG_ITEM_FIELDS = Object.freeze([
  'id',
  'title',
  'description',
  'contentKind',
  'sourceProvider',
  'sourceVideoId',
  'identityUrl',
  'sourceCreatorId',
  'sourceCreatorUrl',
  'sourcePublishedAt',
