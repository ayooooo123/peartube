+static void map_scan_ephemerons(JSRuntime *rt, JSWeakRefHeader *wh,
+                                JS_MarkFunc *mark_func)
+{
+    JSMapState *s = container_of(wh, JSMapState, weakref_header);
+    struct list_head *el;
+
+    if (!s->gc_live)
+        return;
+    list_for_each(el, &s->records) {
+        JSMapRecord *mr = list_entry(el, JSMapRecord, link);
+        if (!mr->empty && !mr->gc_marked && js_weakref_is_live(mr->key)) {
+            mr->gc_marked = TRUE;
+            JS_MarkValue(rt, mr->value, mark_func);
+        }
+    }
+}
+
+static void map_finish_ephemerons(JSRuntime *rt, JSWeakRefHeader *wh)
+{
+    JSMapState *s = container_of(wh, JSMapState, weakref_header);
+    struct list_head *el;
+
+    if (!s->gc_live)
+        return;
+    s->gc_live = FALSE;
+    list_for_each(el, &s->records) {
+        JSMapRecord *mr = list_entry(el, JSMapRecord, link);
+        if (mr->gc_marked) {
+            mr->gc_marked = FALSE;
+        } else if (!mr->empty) {
+            /* gc_decref already dropped this WeakMap's reference to GC-object
+               values; sever the dead record's edge before gc_free_cycles. */
+            switch (JS_VALUE_GET_TAG(mr->value)) {
+            case JS_TAG_OBJECT:
+            case JS_TAG_FUNCTION_BYTECODE:
+            case JS_TAG_MODULE:
+                mr->value = JS_UNDEFINED;
+                break;
+            default:
+                break;
+            }
+        }
+    }
+}
