  has(s) {
    return s.index < this.sessions.length && this.sessions[s.index] === s
  }

  add(s) {
    if (this.has(s)) return
    s.index = this.sessions.push(s) - 1
  }

  remove(s) {
    if (!this.has(s)) return

    const head = this.sessions.pop()
    if (head === s) return
