  }
})

const uint32be = (exports.uint32be = {
  preencode(state, n) {
    state.end += 4
  },
  encode(state, n) {
    validateUint(n)
    state.buffer[state.start++] = n >>> 24
    state.buffer[state.start++] = n >>> 16
    state.buffer[state.start++] = n >>> 8
    state.buffer[state.start++] = n
