        if (err) {
          return { type, id, stream, error: error.decode(state), data: null }
        }

        if (stream === 0) {
          return { type, id, stream, error: null, data: c.buffer.decode(state) }
        }

        return { type, id, stream, error: null, data: null }
      }

      case t.STREAM: {
        const stream = c.uint.decode(state)

        if (stream & s.ERROR) {
          return { type, id, stream, error: error.decode(state), data: null }
        }

        if (stream & s.DATA) {
          return { type, id, stream, error: null, data: c.buffer.decode(state) }
        }

        return { type, id, stream, error: null, data: null }
