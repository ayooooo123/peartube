{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nitrovlc"],
  "ios": {
    "iosModuleName": "NitroVLC"
  },
  "android": {
    "androidNamespace": ["com", "nitrovlc"],
    "androidCxxLibName": "NitroVLC"
  },
  "autolinking": {
    "NitroVLCView": {
      "swift": "HybridNitroVLCView",
      "kotlin": "HybridNitroVLCView"
    },
    "NitroVLCModule": {
      "swift": "HybridNitroVLCModule",
      "kotlin": "HybridNitroVLCModule"
    }
  },
  "ignorePaths": ["**/node_modules"]
}
