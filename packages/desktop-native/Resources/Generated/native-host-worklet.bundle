  'secretkey',
  'privatekey',
  'mnemonic',
  'seed',
  'seedphrase',
  'password',
  'passphrase',
  'secret',
  'token',
  'authtoken',
  'accesstoken',
  'refreshtoken',
  'apikey',
  'encryptionkey'
