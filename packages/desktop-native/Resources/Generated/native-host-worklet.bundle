    this._openp().then(cb, cb)
  }

  _predestroy() {
    if (this._range) this._range.destroy()
    this.core.close().then(noop, noop)
  }

  _destroy(cb) {
    if (this._range) this._range.destroy()
    this.core.close().then(cb, cb)
  }

  async _readp() {
    if (this._pos >= this._end) {
      this.push(null)
      return
