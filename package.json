{
  "name": "peartube",
  "version": "0.4.38",
  "description": "Decentralized CDN and debrid provider on the Holepunch stack",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "imports": {
    "node:crypto": {
      "bare": "peartube-crypto",
      "default": "node:crypto"
    },
    "node:child_process": {
      "bare": "bare-subprocess",
      "default": "node:child_process"
    },
    "node:events": {
      "bare": "bare-events",
      "default": "node:events"
    },
    "node:fs": {
      "bare": "bare-fs",
      "default": "node:fs"
    },
    "node:http": {
      "bare": "bare-http1",
      "default": "node:http"
    },
    "node:https": {
      "bare": "bare-https",
      "default": "node:https"
    },
    "node:net": {
      "bare": "bare-net",
      "default": "node:net"
    },
    "node:process": {
      "bare": "bare-process",
      "default": "node:process"
    },
    "node:os": {
      "bare": "bare-os",
      "default": "node:os"
    },
    "node:path": {
      "bare": "bare-path",
      "default": "node:path"
    },
    "buffer": {
      "bare": "bare-buffer",
      "default": "node:buffer"
    },
    "crypto": {
      "bare": "peartube-crypto",
      "default": "node:crypto"
    },
    "dgram": {
      "bare": "bare-dgram",
      "default": "node:dgram"
    },
    "events": {
      "bare": "bare-events",
      "default": "node:events"
    },
    "net": {
      "bare": "bare-net",
      "default": "node:net"
    },
    "os": {
      "bare": "bare-os",
      "default": "node:os"
    }
  },
  "bin": {
    "peartube-relay": "bin/relay.js",
    "peartube-private-relay": "bin/private-relay.js",
    "peartube-receiver": "bin/receiver.js"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');if(fs.existsSync('node_modules')){for(const[k,v]of[['events','bare-events'],['dgram','bare-dgram'],['os','bare-os'],['net','bare-net'],['crypto','peartube-crypto'],['buffer','bare-buffer']])if(fs.existsSync(p.join('node_modules',v))){const t=p.join('node_modules',k);fs.rmSync(t,{recursive:true,force:true});fs.symlinkSync(v,t)}try{const b=require('bare-runtime')();fs.chmodSync(b,0o755);fs.mkdirSync('node_modules/.bin',{recursive:true});fs.rmSync('node_modules/.bin/bare',{force:true});fs.symlinkSync(p.relative('node_modules/.bin',b),'node_modules/.bin/bare')}catch{}}\"",
    "start": "./node_modules/.bin/bare bin/relay.js",
    "receiver": "node bin/receiver.js",
    "test": "node --test --test-force-exit test/*.test.js",
    "test:desktop": "node --test test/desktop.e2e.js",
    "test:cast": "node --test test/cast.e2e.js",
    "test:web": "node --test test/web-player.e2e.js",
    "app": "sh desktop/bundle.sh --open"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "autobee": "2.12.1",
    "b4a": "^1.8.0",
    "bare": "1.36.0",
    "bare-buffer": "^3.7.1",
    "bare-dgram": "1.1.1",
    "bare-events": "^2.9.1",
    "bare-fs": "^4.7.2",
    "bare-http1": "^4.6.2",
    "bare-https": "^3.1.0",
    "bare-net": "2.3.3",
    "bare-os": "3.9.1",
    "bare-path": "^3.0.1",
    "bare-process": "4.5.1",
    "bare-subprocess": "^6.2.2",
    "bonjour-service": "^1.4.4",
    "corestore": "^7.12.6",
    "hyperblobs": "^2.12.1",
    "hypercore-blob-server": "1.15.1",
    "hypercore-storage": "^3.4.0",
    "hyperdht": "^6.34.1",
    "hyperswarm": "^4.17.2",
    "peartube-crypto": "file:worklet/crypto",
    "sodium-native": "github:ayooooo123/sodium-native#562d642e1a78a8e124cf97bfbda77f01c02d1a7f",
    "streamx": "^2.28.0"
  },
  "devDependencies": {
    "bare-link": "4.1.0",
    "bare-pack": "3.0.2"
  },
  "overrides": {
    "sodium-native": "$sodium-native"
  },
  "private": true
}
