module.exports = function getMimeType (name, charset = true) {
  if (!name) return null
  let e = m[name.slice(name.lastIndexOf('.') + 1).toLowerCase()]
  if (!e) e = m.bin
  return e.type + (charset && e.charset ? '; charset=' + e.charset : '')
}
