    return this.db.closed
  }

  enter() {
    return this.lock.lock()
  }

  exit() {
    this.tx = null
    this.lock.unlock()
  }

  ready() {
    return this.db.ready()
  }

  close() {
    if (this.write !== null) this.write.destroy()
    return this.db.close()
  }

  finalize(collection, versions, checkout, tracing, key, value) {
    if (value === null) return null

